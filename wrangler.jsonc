{
  "name": "spinningwheelchoice",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "spinningwheelchoice.com", "custom_domain": true },
    { "pattern": "www.spinningwheelchoice.com", "custom_domain": true }
  ]
}
