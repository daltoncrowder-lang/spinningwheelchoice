---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const url = `https://spinningwheelchoice.com/guides/${g.id}/`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: g.data.title, description: g.data.description,
    dateModified: g.data.updated.toISOString().slice(0, 10), mainEntityOfPage: url,
    publisher: { '@type': 'Organization', name: 'SpinningWheelChoice', url: 'https://spinningwheelchoice.com/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: g.data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Guides', item: 'https://spinningwheelchoice.com/guides/' },
    { '@type': 'ListItem', position: 2, name: g.data.title, item: url } ] },
];
---
<Base title={`${g.data.title} | SpinningWheelChoice`} description={g.data.description} schema={schema}>
  <h1>{g.data.title}</h1>
  <p class="answer">{g.data.answer}</p>
  <Content />
  <div class="cta">
    <p>The spinner is free and works on any phone or laptop.</p>
    <a href="/">Open the wheel spinner</a>
  </div>
  <h2>Frequently asked questions</h2>
  <dl class="faq">
    {g.data.faqs.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}
  </dl>
  <p class="meta">Updated {g.data.updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}. <a href="/guides/">More wheel guides</a></p>
</Base>
